bindsym Mod4+Shift+x exec swaylock -c 000000

# Kunci layar otomatis setelah 5 menit tidak ada aktivitas
exec swayidle -w \
     timeout 300 'swaylock -c 000000' \
     timeout 600 'swaymsg "output * dpms off"' \
     resume 'swaymsg "output * dpms on"'

# Mengubah ketebalan border jendela (2 pixel) dan menghilangkan titlebar tebal
default_border pixel 2
default_floating_border pixel 2

# Simpan riwayat copy-paste
exec wl-paste --watch cliphist store

# Buka riwayat clipboard dengan SUPER + Clipboard/Shift + V
# bindsym Mod4+Shift+v exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

exec mako

# Shutdown laptop dengan SUPER + Shift + BackSpace
bindsym Mod4+Shift+BackSpace exec systemctl poweroff

# Reboot laptop dengan SUPER + Shift + r (opsional)
bindsym Mod4+Shift+r exec systemctl reboot

