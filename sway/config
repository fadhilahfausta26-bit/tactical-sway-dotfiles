include /etc/sway/config.d/*


input "type:touchpad" dwt enabled
input "type:touchpad" tap enabled
input "type:touchpad" natural_scroll enabled
input "type:touchpad" pointer_accel 0.3

# Screenshot langsung ke Clipboard (tanpa simpan file)
bindsym --to-code Ctrl+Print exec grim - | wl-copy
bindsym --to-code Ctrl+Shift+Print exec slurp | grim -g - - | wl-copy

bindsym --to-code Mod4+e exec thunar

bindsym --to-code Mod4+Shift+w exec zen-browser

# 1. Touchpad Laptop
