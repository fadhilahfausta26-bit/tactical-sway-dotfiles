#!/bin/bash
dir=$(dirname "$1")
file=$(basename "$1")
ext="${file##*.}"
cd "$dir" || exit 1

if [ "$ext" = "java" ]; then
    class="${file%.java}"
    javac "$file" && java "$class"
elif [ "$ext" = "py" ]; then
    if [ -x "venv/bin/python" ]; then
        ./venv/bin/python "$file"
    elif [ -x ".venv/bin/python" ]; then
        ./.venv/bin/python "$file"
    else
        python3 "$file"
    fi
fi
